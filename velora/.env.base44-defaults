# Committed placeholders so the app boots before real credentials exist.
# The platform-managed /run/base44/app.env is listed AFTER this file in
# docker-compose.base44.yml, so dashboard values always override these.
# Never put a real secret in this file.

# RIA ROLEPLAY Tebex store (administrator-supplied, dashboard secrets win).
TEBEX_STORE_URL=
TEBEX_PUBLIC_TOKEN=
TEBEX_SECRET_KEY=
TEBEX_WEBHOOK_SECRET=

# FiveM delivery endpoint (optional; without it deliveries park as pending).
FIVEM_DELIVERY_WEBHOOK_URL=
FIVEM_DELIVERY_SECRET=

# Comma-separated emails that should always receive the administrator role.
ADMIN_EMAILS=
