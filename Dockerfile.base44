FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Only the dependency manifest is baked into the image; application source is
# bind-mounted from the checkout by docker-compose.base44.yml.
COPY requirements.txt /app/requirements.txt
RUN pip install -r /app/requirements.txt
